# Cloudflare Pages 静态资源缓存策略
# 说明：本项目无构建步骤、文件名不带哈希，站点自身的 js/css 必须每次重新验证
#       （命中时返回 304，开销极小），否则发版后用户会拿到新 HTML + 旧脚本/样式。

# 第三方库（hls.js / ArtPlayer / sha256）很少变动：浏览器缓存 7 天
/libs/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# 站点自身脚本与样式：每次验证
/js/*
  Cache-Control: public, max-age=0, must-revalidate
/css/*
  Cache-Control: public, max-age=0, must-revalidate

# 图标等图片：1 天
/image/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# 巡检数据：每次验证
/data/*
  Cache-Control: public, max-age=0, must-revalidate

# HTML 始终重新验证
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate

# Early Hints（Cloudflare 面板 Speed → Protocol 开启）
# Cloudflare 会缓存 103 提示，因此这里只放不带版本号、长期不变的第三方库；
# 带 ?v= 的站内 css/js 不放，否则发版后一段时间内会预加载到旧版本文件。
/player
  Link: </libs/hls-1.7.3.min.js>; rel=preload; as=script; crossorigin, </libs/artplayer.min.js>; rel=preload; as=script; crossorigin
